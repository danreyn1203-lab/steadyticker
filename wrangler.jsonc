{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Worker name → also the *.workers.dev subdomain. Changes together with the
  // brand/repo rename (see site.name). Rename here when the final name is set.
  "name": "quietticker",
  "main": ".open-next/worker.js",
  // nodejs_compat is required by the OpenNext adapter; the date must be recent
  // enough to enable it (>= 2024-09-23).
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  // Writable data store: reader accounts, subscribers, broadcast history.
  // Create the namespace with `npx wrangler kv namespace create DATA`, then
  // paste the printed id below (and a preview_id for `wrangler dev` if wanted).
  "kv_namespaces": [
    {
      "binding": "DATA",
      "id": "cf6626a7042e405baceec3d1a6cfafd7"
    }
  ]
}

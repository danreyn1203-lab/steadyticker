# Copy this file to .env.local and set your own values.
# .env.local is git-ignored, so your real secrets never get committed.

# Public site URL (used for SEO: canonical links, sitemap, Open Graph).
# Leave unset in dev (defaults to http://localhost:3000); set to your real
# domain in production, e.g. https://steadyticker.com.
NEXT_PUBLIC_SITE_URL=

# The email + password you type at /admin to edit research. Change either here
# and restart the server — these are your login, stored only in this file.
# If AUTHOR_EMAIL is left blank, /admin asks for the password alone.
AUTHOR_EMAIL=
AUTHOR_PASSWORD=

# A long random string used to sign the login cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTHOR_SESSION_SECRET=

# ---- Email (Resend HTTP API) ----
# Powers BOTH the newsletter AND reader sign-up verification codes. Uses a
# single HTTPS request, so it works locally AND on Cloudflare Workers (SMTP
# does not run on Workers). Leave blank for mailto/dev-fallback mode
# (verification codes then print to the server console instead of sending).
#
# 1. Create a key at https://resend.com/api-keys  -> RESEND_API_KEY
# 2. Set the sender. Before your domain is verified, test with:
#       NEWSLETTER_FROM=SteadyTicker <onboarding@resend.dev>
#    (Resend only delivers onboarding@resend.dev to your own account email.)
#    Once you verify a domain at https://resend.com/domains, switch to it:
#       NEWSLETTER_FROM=SteadyTicker <hello@your-domain.com>
# Restart the dev server after editing.
RESEND_API_KEY=
NEWSLETTER_FROM=

# ---- Daily price refresh (optional) ----
# Prices update on their own the first time a page renders after the 6-hour
# cache expires, so nothing here is required. Set this only if you want a
# scheduler to call GET /api/cron/refresh-quotes at a fixed time each day:
#   curl -H "Authorization: Bearer $CRON_SECRET" https://your-site/api/cron/refresh-quotes
CRON_SECRET=
